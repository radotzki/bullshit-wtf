{
  "hosting": {
    "public": "game/dist",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/he",
        "destination": "/he.html"
      },
      {
        "source": "/he/**",
        "destination": "/he.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database-rules.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix functions run build"
    ]
  }
}
