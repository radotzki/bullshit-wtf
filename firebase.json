{
  "hosting": {
    "public": "game/dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/_daily",
        "function": "daily"
      },
      {
        "regex": "^/(he/)?daily/(past|\\d{4}-\\d{2}-\\d{2})/?$",
        "function": "dailyPast"
      },
      {
        "source": "/sitemap-daily.xml",
        "function": "dailyPast"
      },
      {
        "source": "/_v",
        "function": "visit"
      },
      {
        "source": "/join-game/*",
        "function": "joinPreview"
      },
      {
        "source": "/he/join-game/*",
        "function": "joinPreview"
      },
      {
        "regex": "^/he/?$",
        "destination": "/he.html"
      },
      {
        "regex": "^/he/(join-game/?|c/[^/]+/?|challenge/[^/]+/?)$",
        "destination": "/he.html"
      },
      {
        "regex": "^/(m|d|create-game|join-game|present-game|learn)/?$",
        "destination": "/index.html"
      },
      {
        "regex": "^/(present-game|c|challenge|game-staging|round-intro|show-question|show-answers|reveal-the-truth|score-board|score-board-final|step)/[^/]+/?$",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "regex": "^/(m|d|create-game|join-game|present-game|learn|c|challenge|game-staging|round-intro|show-question|show-answers|reveal-the-truth|score-board|score-board-final|step|he/join-game|he/c|he/challenge)(/.*)?$",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/(he/?)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/(he/)?[a-z0-9-]+/?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/(he/)?(present-game|c|challenge|game-staging|round-intro|show-question|show-answers|reveal-the-truth|score-board|score-board-final|step)/[^/.]+/?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database-rules.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix functions run build"
    ]
  }
}
