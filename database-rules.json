{
    "rules": {
        "qHistory": {
            ".read": "auth.uid == 'bl-service-worker'",
            ".write": "auth.uid == 'bl-service-worker'"
        },
        "seenQuestions": {
            ".read": "auth.uid == 'bl-service-worker'",
            ".write": "auth.uid == 'bl-service-worker'"
        },
        "gameCounter": {
            ".read": "auth.uid == 'bl-service-worker'",
            ".write": "auth.uid == 'bl-service-worker'"
        },
        "questions": {
            ".read": "auth.uid == 'bl-service-worker'",
            ".write": "auth.uid == 'bl-service-worker'",
            ".indexOn": [
                "lang"
            ]
        },
        "crews": {
            "$id": {
                ".read": "true",
                ".write": "auth.uid == 'bl-service-worker'"
            }
        },
        "games": {
            "$pin": {
                ".write": "auth.uid == 'bl-service-worker'",
                ".read": "auth.uid == 'bl-service-worker'",
                "state": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "timestamp": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "roundIndex": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "questionIndex": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "locale": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "pack": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "currentQ": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "answers": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "answerSelections": {
                    ".read": "true",
                    ".write": "true"
                },
                "revealAnswers": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "totalQ": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "players": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "qids": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "revealDone": {
                    ".read": "true",
                    "$pid": {
                        ".write": "newData.val() === true"
                    }
                },
                "tick": {
                    ".read": "true",
                    ".write": "!(root.child('games').child($pin).child('state').child('id').val() === 0 && root.child('games').child($pin).child('serverStart').val() === true)"
                },
                "presenter": {
                    ".read": "true",
                    ".write": "true"
                },
                "fork": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "creator": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "hasHost": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "hostSeen": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "crew": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "coach": {
                    ".read": "true",
                    ".write": "auth.uid == 'bl-service-worker'"
                },
                "ideas": {
                    "$pid": {
                        ".read": "auth != null && root.child('games').child($pin).child('players').child($pid).child('uid').val() === auth.uid"
                    }
                }
            }
        }
    }
}