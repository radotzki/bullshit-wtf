{
  "name": "client",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "copy-model": "node -e \"require('fs').copyFileSync('../game-model.ts', 'src/app/game-model.ts')\"",
    "start": "npm run copy-model && node --openssl-legacy-provider node_modules/@angular/cli/bin/ng serve --host 0.0.0.0 -o",
    "build": "npm run copy-model && ng lint && node --openssl-legacy-provider node_modules/@angular/cli/bin/ng build -prod"
  },
  "dependencies": {
    "@angular/common": "^4.0.0",
    "@angular/compiler": "^4.0.0",
    "@angular/core": "^4.0.0",
    "@angular/forms": "^4.0.0",
    "@angular/http": "^4.0.0",
    "@angular/platform-browser": "^4.0.0",
    "@angular/platform-browser-dynamic": "^4.0.0",
    "@angular/router": "^4.0.0",
    "bulma": "^0.9.3",
    "core-js": "^2.4.1",
    "enhanced-resolve": "^3.3.0",
    "firebase": "^3.7.2",
    "howler": "^2.2.3",
    "rxjs": "^5.1.0",
    "zone.js": "^0.8.4",
    "raven-js": "3.26.4"
  },
  "devDependencies": {
    "@angular/cli": "1.7.3",
    "@angular/compiler-cli": "^4.0.0",
    "codelyzer": "~2.0.0",
    "tslint": "~4.4.2",
    "typescript": "~2.3.4"
  },
  "private": true,
  "overrides": {
    "node-sass": "npm:sass@1.32.13"
  },
  "engines": {
    "node": ">=18"
  }
}
